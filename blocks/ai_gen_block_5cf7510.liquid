{% doc %}
  @prompt
    i have a portrait image that is a new feature to our store so i want to spotlight it. but i dont want the section to feel massive on mobile, and i dont want any of the image to be cut off either. i want it to feel magazine style editorial
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-spotlight-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: clamp(24px, 5vw, 72px) clamp(16px, 4vw, 56px);
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-spotlight__layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.95fr);
    align-items: center;
    gap: clamp(28px, 6vw, 88px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-editorial-spotlight__media-{{ ai_gen_id }} {
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-editorial-spotlight__image-{{ ai_gen_id }} {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: {{ block.settings.image_max_height }}px;
    object-fit: contain;
  }

  .ai-editorial-spotlight__placeholder-{{ ai_gen_id }} {
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 4 / 5;
    background: #e8e6e1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-spotlight__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    color: #8a8781;
  }

  .ai-editorial-spotlight__empty-{{ ai_gen_id }} {
    position: absolute;
    inset-inline: 12px;
    bottom: 12px;
    text-align: center;
    color: #45423e;
    font-size: 12px;
    line-height: 1.4;
  }

  .ai-editorial-spotlight__copy-{{ ai_gen_id }} {
    max-width: 520px;
    padding-block: 12px;
  }

  .ai-editorial-spotlight__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 18px;
    font-family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }};
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-editorial-spotlight__heading-{{ ai_gen_id }} {
    margin: 0;
    color: inherit;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: clamp(32px, 5vw, {{ block.settings.heading_size }}px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  .ai-editorial-spotlight__body-{{ ai_gen_id }} {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.75;
  }

  .ai-editorial-spotlight__body-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-editorial-spotlight__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    padding: 0 0 6px;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-spotlight__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-spotlight-{{ ai_gen_id }} {
      width: 100%;
      padding: 24px 18px 30px;
    }

    .ai-editorial-spotlight__layout-{{ ai_gen_id }} {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 16px;
      align-items: center;
    }

    .ai-editorial-spotlight__image-{{ ai_gen_id }} {
      max-height: {{ block.settings.mobile_image_max_height }}px;
    }

    .ai-editorial-spotlight__copy-{{ ai_gen_id }} {
      padding: 4px 0;
    }

    .ai-editorial-spotlight__eyebrow-{{ ai_gen_id }} {
      margin-bottom: 10px;
      font-size: 10px;
    }

    .ai-editorial-spotlight__heading-{{ ai_gen_id }} {
      font-size: clamp(24px, 7vw, 36px);
    }

    .ai-editorial-spotlight__body-{{ ai_gen_id }} {
      margin-top: 12px;
      font-size: 13px;
      line-height: 1.55;
    }

    .ai-editorial-spotlight__link-{{ ai_gen_id }} {
      margin-top: 15px;
      font-size: 10px;
      gap: 6px;
    }
  }

  @media screen and (max-width: 380px) {
    .ai-editorial-spotlight__layout-{{ ai_gen_id }} {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 12px;
    }

    .ai-editorial-spotlight__heading-{{ ai_gen_id }} {
      font-size: 23px;
    }

    .ai-editorial-spotlight__body-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-editorial-spotlight-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-spotlight__layout-{{ ai_gen_id }}">
    <div class="ai-editorial-spotlight__media-{{ ai_gen_id }}">
      {% if block.settings.image != blank %}
        <img
          class="ai-editorial-spotlight__image-{{ ai_gen_id }}"
          src="{{ block.settings.image | image_url: width: 1400 }}"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-editorial-spotlight__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <span class="ai-editorial-spotlight__empty-{{ ai_gen_id }}">Add a portrait image to feature your new store highlight.</span>
        </div>
      {% endif %}
    </div>
    <div class="ai-editorial-spotlight__copy-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-spotlight__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-spotlight__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-editorial-spotlight__body-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.link_label != blank and block.settings.link_url != blank %}
        <a class="ai-editorial-spotlight__link-{{ ai_gen_id }}" href="{{ block.settings.link_url }}">
          {{ block.settings.link_label | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial spotlight",
  "settings": [
    {
      "type": "header",
      "content": "Feature content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "A closer look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the latest"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Introduce a new favorite with a little room to breathe and a distinctly editorial feel.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Discover the feature"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout and style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_max_height",
      "label": "Image height on desktop",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "mobile_image_max_height",
      "label": "Image height on mobile",
      "min": 160,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 36,
      "max": 76,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F1F1F1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#2B2B2B"
    }
  ],
  "presets": [
    {
      "name": "Editorial spotlight"
    }
  ],
  "tag": null,
  "class": "editorial-spotlight-block"
}
{% endschema %}