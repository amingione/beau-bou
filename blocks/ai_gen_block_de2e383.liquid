{% doc %}
  @prompt
    A magazine-style editorial layout, this is going to be the main section and its intended use is to replace the current block that says "our story" & "Love and kindness, always" etc. so it neds to be top of the page and have a google revoews sectio n below it
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: clamp(24px, 5vw, 68px) clamp(16px, 4vw, 48px);
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-editorial-{{ ai_gen_id }}__inner { max-width: 1120px; margin: 0 auto; }
  .ai-editorial-{{ ai_gen_id }}__masthead { text-align: center; border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; padding: 14px 0 18px; margin-bottom: clamp(24px, 4vw, 48px); }
  .ai-editorial-{{ ai_gen_id }}__eyebrow { margin: 0 0 12px; color: {{ block.settings.accent_color }}; font-size: 11px; font-weight: 600; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__title { max-width: 900px; margin: 0 auto; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: clamp(36px, 7vw, {{ block.settings.title_size }}px); font-weight: 400; letter-spacing: -.035em; line-height: .98; }
  .ai-editorial-{{ ai_gen_id }}__dek { max-width: 670px; margin: 18px auto 0; font-size: clamp(16px, 2vw, 20px); line-height: 1.55; }
  .ai-editorial-{{ ai_gen_id }}__hero, .ai-editorial-{{ ai_gen_id }}__secondary { margin: 0; }
  .ai-editorial-{{ ai_gen_id }}__hero img, .ai-editorial-{{ ai_gen_id }}__secondary img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__hero-placeholder, .ai-editorial-{{ ai_gen_id }}__secondary-placeholder { position: relative; background: #e5e5e5; }
  .ai-editorial-{{ ai_gen_id }}__hero-placeholder { aspect-ratio: 16 / 8; }
  .ai-editorial-{{ ai_gen_id }}__secondary-placeholder { aspect-ratio: 4 / 5; }
  .ai-editorial-{{ ai_gen_id }}__hero-placeholder svg, .ai-editorial-{{ ai_gen_id }}__secondary-placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-editorial-{{ ai_gen_id }}__empty { position: absolute; right: 12px; bottom: 12px; left: 12px; padding: 9px 12px; background: #fff; color: #333; font-size: 12px; text-align: center; }
  .ai-editorial-{{ ai_gen_id }}__caption { margin: 10px 0 0; font-size: 11px; line-height: 1.5; }
  .ai-editorial-{{ ai_gen_id }}__content-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(210px, .62fr); gap: clamp(28px, 6vw, 76px); align-items: start; margin: clamp(32px, 6vw, 68px) auto; max-width: 900px; }
  .ai-editorial-{{ ai_gen_id }}__body { font-size: 15px; line-height: 1.85; }
  .ai-editorial-{{ ai_gen_id }}__body p:first-child:first-letter { float: left; margin: 7px 8px 0 0; color: {{ block.settings.accent_color }}; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: 3.8em; line-height: .72; }
  .ai-editorial-{{ ai_gen_id }}__quote { margin: 0 0 24px; padding: 18px 0 18px 20px; border-left: 2px solid {{ block.settings.accent_color }}; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: clamp(22px, 3vw, 30px); font-style: italic; line-height: 1.3; }
  .ai-editorial-{{ ai_gen_id }}__byline { display: block; margin-top: 14px; color: {{ block.settings.accent_color }}; font-family: sans-serif; font-size: 10px; font-style: normal; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__reviews { margin: clamp(44px, 7vw, 84px) auto 0; padding: clamp(28px, 5vw, 52px) 20px; border-top: 1px solid currentColor; text-align: center; }
  .ai-editorial-{{ ai_gen_id }}__reviews-title { margin: 0; font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }}; font-size: clamp(28px, 4vw, 42px); font-weight: 400; }
  .ai-editorial-{{ ai_gen_id }}__reviews-copy { max-width: 600px; margin: 12px auto 20px; font-size: 15px; line-height: 1.7; }
  .ai-editorial-{{ ai_gen_id }}__reviews-link { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; padding: 11px 22px; border: 1px solid {{ block.settings.accent_color }}; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .ai-editorial-{{ ai_gen_id }}__reviews-link:hover { background: {{ block.settings.accent_color }}; color: #fff; }
  .ai-editorial-{{ ai_gen_id }}__reviews-link:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (max-width: 700px) {
    .ai-editorial-{{ ai_gen_id }}__content-grid { grid-template-columns: 1fr; gap: 26px; }
    .ai-editorial-{{ ai_gen_id }}__secondary { max-width: 420px; }
    .ai-editorial-{{ ai_gen_id }}__hero-placeholder { aspect-ratio: 4 / 3; }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <header class="ai-editorial-{{ ai_gen_id }}__masthead">
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.title != blank %}<h1 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h1>{% endif %}
      {% if block.settings.dek != blank %}<p class="ai-editorial-{{ ai_gen_id }}__dek">{{ block.settings.dek | escape }}</p>{% endif %}
    </header>
    <figure class="ai-editorial-{{ ai_gen_id }}__hero">
      {% if block.settings.hero_image != blank %}
        <img src="{{ block.settings.hero_image | image_url: width: 2200 }}" alt="{{ block.settings.hero_image.alt | escape }}" width="{{ block.settings.hero_image.width }}" height="{{ block.settings.hero_image.height }}" loading="lazy">
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__hero-placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-{{ ai_gen_id }}__empty">Add a lead editorial image</span></div>
      {% endif %}
      {% if block.settings.hero_caption != blank %}<figcaption class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.hero_caption | escape }}</figcaption>{% endif %}
    </figure>
    <div class="ai-editorial-{{ ai_gen_id }}__content-grid">
      <div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.story_body }}</div>
      <aside>
        {% if block.settings.pull_quote != blank %}<blockquote class="ai-editorial-{{ ai_gen_id }}__quote">{{ block.settings.pull_quote | escape }}{% if block.settings.quote_attribution != blank %}<cite class="ai-editorial-{{ ai_gen_id }}__byline">{{ block.settings.quote_attribution | escape }}</cite>{% endif %}</blockquote>{% endif %}
        {% if block.settings.secondary_image != blank %}
          <figure class="ai-editorial-{{ ai_gen_id }}__secondary"><img src="{{ block.settings.secondary_image | image_url: width: 1000 }}" alt="{{ block.settings.secondary_image.alt | escape }}" width="{{ block.settings.secondary_image.width }}" height="{{ block.settings.secondary_image.height }}" loading="lazy">{% if block.settings.secondary_caption != blank %}<figcaption class="ai-editorial-{{ ai_gen_id }}__caption">{{ block.settings.secondary_caption | escape }}</figcaption>{% endif %}</figure>
        {% else %}
          <div class="ai-editorial-{{ ai_gen_id }}__secondary-placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-editorial-{{ ai_gen_id }}__empty">Add a supporting image</span></div>
        {% endif %}
      </aside>
    </div>
    {% if block.settings.reviews_eyebrow != blank or block.settings.reviews_title != blank or block.settings.reviews_copy != blank or block.settings.google_reviews_link != blank %}
    <section class="ai-editorial-{{ ai_gen_id }}__reviews" aria-labelledby="ai-editorial-reviews-{{ ai_gen_id }}">
      <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.reviews_eyebrow | escape }}</p>
      <h2 class="ai-editorial-{{ ai_gen_id }}__reviews-title" id="ai-editorial-reviews-{{ ai_gen_id }}">{{ block.settings.reviews_title | escape }}</h2>
      <p class="ai-editorial-{{ ai_gen_id }}__reviews-copy">{{ block.settings.reviews_copy | escape }}</p>
      {% if block.settings.google_reviews_link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__reviews-link" href="{{ block.settings.google_reviews_link }}" target="_blank" rel="noopener noreferrer">{{ block.settings.reviews_button | escape }}</a>{% endif %}
    </section>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Our story and reviews",
  "settings": [
    { "type": "header", "content": "Our story" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Section label", "default": "Our story" },
    { "type": "text", "id": "title", "label": "Headline", "default": "Love and kindness, always" },
    { "type": "textarea", "id": "dek", "label": "Introduction", "default": "A little about the heart behind Be-YOU-tiful Boutique." },
    { "type": "richtext", "id": "story_body", "label": "Story text", "default": "<p>Welcome to Be-YOU-tiful Boutique. Our story is rooted in helping every woman feel seen, celebrated, and comfortable being herself.</p><p>From everyday favorites to special-occasion looks, we are delighted to help you find pieces that feel just right for you.</p>" },
    { "type": "header", "content": "Photography" },
    { "type": "image_picker", "id": "hero_image", "label": "Lead image" },
    { "type": "text", "id": "hero_caption", "label": "Lead image caption" },
    { "type": "image_picker", "id": "secondary_image", "label": "Supporting image" },
    { "type": "text", "id": "secondary_caption", "label": "Supporting image caption" },
    { "type": "header", "content": "Pull quote" },
    { "type": "textarea", "id": "pull_quote", "label": "Quote", "default": "Love and kindness, always." },
    { "type": "text", "id": "quote_attribution", "label": "Attribution", "default": "Michele" },
    { "type": "header", "content": "Google reviews" },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "heading_font", "label": "Display font", "default": "playfair_display_n4" },
    { "type": "range", "id": "title_size", "label": "Headline size", "min": 40, "max": 80, "step": 5, "unit": "px", "default": 60 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2B2B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#3A4543" }
  ],
  "presets": [{ "name": "Our story and reviews" }],
  "tag": null,
  "class": "editorial-layout"
}
{% endschema %}
