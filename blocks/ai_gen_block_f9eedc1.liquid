{% doc %}
  @prompt
    build a magazine style editorial lightweight carousel for the google reviews to be added, i want the carousel to rotate automatically and not be biulk or take up a lot of screen space on either desktop or mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-review-carousel-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding:18px 22px; color:{{ block.settings.text_color }}; background:{{ block.settings.background_color }}; border-top:1px solid {{ block.settings.text_color | color_modify: 'alpha', 0.25 }}; border-bottom:1px solid {{ block.settings.text_color | color_modify: 'alpha', 0.25 }}; box-sizing:border-box; }
  .ai-review-carousel-{{ ai_gen_id }} * { box-sizing:border-box; }
  .ai-review-carousel-{{ ai_gen_id }}__inner { max-width:760px; margin:0 auto; text-align:center; }
  .ai-review-carousel-{{ ai_gen_id }}__eyebrow { margin:0 0 7px; font-size:10px; line-height:1.4; letter-spacing:.16em; text-transform:uppercase; font-weight:600; }
  .ai-review-carousel-{{ ai_gen_id }}__heading { margin:0 0 12px; font-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }}; font-size:clamp(20px,3vw,26px); line-height:1.15; font-weight:400; }
  .ai-review-carousel-{{ ai_gen_id }}__viewport { position:relative; min-height:82px; }
  .ai-review-carousel-{{ ai_gen_id }}__slide { display:none; }
  .ai-review-carousel-{{ ai_gen_id }}__slide.is-active { display:block; }
  .ai-review-carousel-{{ ai_gen_id }}__quote { margin:0 auto 9px; max-width:680px; font-family:{{ settings.type_accent_font.family }},{{ settings.type_accent_font.fallback_families }}; font-size:clamp(16px,2.2vw,20px); line-height:1.45; }
  .ai-review-carousel-{{ ai_gen_id }}__author { margin:0; font-size:12px; line-height:1.5; font-weight:600; }
  .ai-review-carousel-{{ ai_gen_id }}__footer { display:flex; justify-content:center; align-items:center; gap:13px; margin-top:11px; }
  .ai-review-carousel-{{ ai_gen_id }}__google { color:inherit; font-size:11px; text-underline-offset:3px; }
  .ai-review-carousel-{{ ai_gen_id }}__controls { display:inline-flex; align-items:center; gap:7px; }
  .ai-review-carousel-{{ ai_gen_id }}__control { display:inline-flex; width:30px; height:30px; align-items:center; justify-content:center; border:1px solid currentColor; border-radius:50%; padding:0; background:transparent; color:inherit; cursor:pointer; font:inherit; }
  .ai-review-carousel-{{ ai_gen_id }}__control:focus-visible,.ai-review-carousel-{{ ai_gen_id }}__google:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  .ai-review-carousel-{{ ai_gen_id }}__control svg { width:13px; height:13px; }
  .ai-review-carousel-{{ ai_gen_id }}__status { min-width:34px; font-size:10px; }
  .ai-review-carousel-{{ ai_gen_id }}__empty { margin:0; font-size:13px; line-height:1.5; }
  @media screen and (max-width:749px) { .ai-review-carousel-{{ ai_gen_id }} { padding:15px 14px; } .ai-review-carousel-{{ ai_gen_id }}__viewport { min-height:90px; } .ai-review-carousel-{{ ai_gen_id }}__footer { margin-top:8px; } }
{% endstyle %}
<review-carousel-{{ ai_gen_id }} class="ai-review-carousel-{{ ai_gen_id }}" data-interval="{{ block.settings.interval_seconds | times: 1000 }}" {{ block.shopify_attributes }}>
  <div class="ai-review-carousel-{{ ai_gen_id }}__inner" aria-roledescription="carousel">
    {% if block.settings.eyebrow != blank %}<p class="ai-review-carousel-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-review-carousel-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-review-carousel-{{ ai_gen_id }}__viewport" aria-live="polite">
      {% assign review_count = 0 %}
      {% for i in (1..3) %}
        {% assign quote_key = 'review_' | append: i | append: '_quote' %}
        {% assign author_key = 'review_' | append: i | append: '_author' %}
        {% assign review_quote = block.settings[quote_key] %}
        {% assign review_author = block.settings[author_key] %}
        {% if review_quote != blank %}
          {% assign review_count = review_count | plus: 1 %}
          <div class="ai-review-carousel-{{ ai_gen_id }}__slide{% if review_count == 1 %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="Review {{ review_count }}">
            <blockquote class="ai-review-carousel-{{ ai_gen_id }}__quote">“{{ review_quote | escape }}”</blockquote>
            {% if review_author != blank %}<p class="ai-review-carousel-{{ ai_gen_id }}__author">{{ review_author | escape }}</p>{% endif %}
          </div>
        {% endif %}
      {% endfor %}
      {% if review_count == 0 %}<p class="ai-review-carousel-{{ ai_gen_id }}__empty">Add your Google review quotes and reviewer names in the block settings to display them here.</p>{% endif %}
    </div>
    {% if review_count > 0 %}
      <div class="ai-review-carousel-{{ ai_gen_id }}__footer">
        {% if settings.bb_google_profile != blank %}<a class="ai-review-carousel-{{ ai_gen_id }}__google" href="{{ settings.bb_google_profile }}" target="_blank" rel="noopener noreferrer">{{ block.settings.google_link_label | escape }}</a>{% endif %}
        {% if review_count > 1 %}
          <div class="ai-review-carousel-{{ ai_gen_id }}__controls">
            <button class="ai-review-carousel-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <span class="ai-review-carousel-{{ ai_gen_id }}__status" aria-label="Current review">1 / {{ review_count }}</span>
            <button class="ai-review-carousel-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</review-carousel-{{ ai_gen_id }}>
<script>
  (() => {
    const tagName = 'review-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ReviewCarousel extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-review-carousel-{{ ai_gen_id }}__slide'));
        if (this.slides.length < 2) return;
        this.current = 0;
        this.status = this.querySelector('.ai-review-carousel-{{ ai_gen_id }}__status');
        this.interval = Number(this.dataset.interval) || 6000;
        this.timer = null;
        this.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', () => { this.show(this.current + (button.dataset.direction === 'next' ? 1 : -1)); this.restart(); }));
        this.addEventListener('mouseenter', () => this.stop());
        this.addEventListener('mouseleave', () => this.start());
        this.addEventListener('focusin', () => this.stop());
        this.addEventListener('focusout', (event) => { if (!this.contains(event.relatedTarget)) this.start(); });
        this.start();
      }
      show(index) {
        this.current = (index + this.slides.length) % this.slides.length;
        this.slides.forEach((slide, slideIndex) => { const active = slideIndex === this.current; slide.classList.toggle('is-active', active); slide.setAttribute('aria-hidden', active ? 'false' : 'true'); });
        if (this.status) this.status.textContent = `${this.current + 1} / ${this.slides.length}`;
      }
      start() { if (this.timer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; this.timer = window.setInterval(() => this.show(this.current + 1), this.interval); }
      stop() { window.clearInterval(this.timer); this.timer = null; }
      restart() { this.stop(); this.start(); }
      disconnectedCallback() { this.stop(); }
    }
    customElements.define(tagName, ReviewCarousel);
  })();
</script>
{% schema %}
{
  "name": "Google review carousel",
  "tag": null,
  "class": "google-review-carousel-block",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A note from our customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kind words" },
    { "type": "text", "id": "google_link_label", "label": "Google link label", "default": "Reviews on Google" },
    { "type": "range", "id": "interval_seconds", "label": "Autoplay interval", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B2B2B" },
    { "type": "header", "content": "Review 1" },
    { "type": "textarea", "id": "review_1_quote", "label": "Review quote" },
    { "type": "text", "id": "review_1_author", "label": "Reviewer name" },
    { "type": "header", "content": "Review 2" },
    { "type": "textarea", "id": "review_2_quote", "label": "Review quote" },
    { "type": "text", "id": "review_2_author", "label": "Reviewer name" },
    { "type": "header", "content": "Review 3" },
    { "type": "textarea", "id": "review_3_quote", "label": "Review quote" },
    { "type": "text", "id": "review_3_author", "label": "Reviewer name" }
  ],
  "presets": [{ "name": "Google review carousel" }]
}
{% endschema %}
