{{ 'section-about-photo-journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign journal_mode = section.settings.mode | default: 'album'
  assign photo_count = 0

  for block in section.blocks
    assign photo = block.settings.image
    if photo != blank and photo.src == blank
      assign filename = photo | remove: 'shopify://shop_images/'
      assign photo = images[filename]
    endif
    if photo != blank
      assign photo_count = photo_count | plus: 1
    endif
  endfor

  assign display_photo_count = photo_count
  if request.design_mode and section.blocks.size > photo_count
    assign display_photo_count = section.blocks.size
  endif
  assign navigation_count = display_photo_count
  if journal_mode == 'album'
    assign navigation_item = 'photo'
  else
    assign navigation_item = 'stop'
  endif
  assign navigation_count_label = navigation_count | prepend: '0' | slice: -2, 2
-%}

{%- if photo_count > 0 or request.design_mode -%}
  <div class="about-journal about-journal--{{ journal_mode }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width about-journal__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
        <header class="about-journal__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="about-journal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="about-journal__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="about-journal__intro rte">{{ section.settings.intro }}</div>
          {%- endif -%}
        </header>
      {%- endif -%}

      {%- if photo_count == 0 and request.design_mode -%}
        <p class="about-journal__hint">Add a Photo block and choose an image to start this section.</p>
      {%- endif -%}

      {%- capture photo_items -%}
        {%- assign photo_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign photo = block.settings.image
            if photo != blank and photo.src == blank
              assign filename = photo | remove: 'shopify://shop_images/'
              assign photo = images[filename]
            endif
          -%}
          {%- if photo != blank or request.design_mode -%}
            {%- assign photo_index = photo_index | plus: 1 -%}
            {%- liquid
              assign photo_alt = block.settings.alt | default: photo.alt | default: block.settings.caption
              if photo_alt == blank
                if journal_mode == 'tour'
                  assign photo_alt = 'Inside Be-YOU-tiful Boutique'
                else
                  assign photo_alt = 'A moment at Be-YOU-tiful Boutique'
                endif
              endif
              if journal_mode == 'album'
                assign photo_sizes = '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 48vw'
              else
                assign photo_sizes = '(min-width: 990px) 31vw, (min-width: 750px) 48vw, 84vw'
              endif
              assign step_index = photo_index | plus: section.settings.step_start | minus: 1
              assign step_number = step_index | prepend: '0' | slice: -2, 2
            -%}
            {%- capture photo_figure -%}
              <figure class="about-journal__figure">
                <div class="about-journal__media">
                  {%- if photo != blank -%}
                    {{
                      photo
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 750, 990, 1300, 1600, 1800',
                        sizes: photo_sizes,
                        class: 'about-journal__image',
                        alt: photo_alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'about-journal__placeholder' }}
                  {%- endif -%}
                </div>
                {%- if journal_mode == 'album' -%}
                  {%- if block.settings.caption != blank or block.settings.note != blank -%}
                    <figcaption class="about-journal__photo-caption">
                      {%- if block.settings.caption != blank -%}
                        <span class="about-journal__caption">{{ block.settings.caption | escape }}</span>
                      {%- endif -%}
                      {%- if block.settings.note != blank -%}
                        <span class="about-journal__album-note">{{ block.settings.note | escape | newline_to_br }}</span>
                      {%- endif -%}
                    </figcaption>
                  {%- endif -%}
                {%- endif -%}
              </figure>
            {%- endcapture -%}
            {%- if journal_mode == 'album' -%}
              <li class="about-journal__item about-journal__item--album" {{ block.shopify_attributes }}>
                {{ photo_figure }}
              </li>
            {%- else -%}
              <li class="about-journal__item about-journal__item--tour" {{ block.shopify_attributes }}>
                {{ photo_figure }}
                <div class="about-journal__detail">
                  <span class="about-journal__step" aria-hidden="true">{{ step_number }}</span>
                  {%- if block.settings.caption != blank -%}
                    <h3 class="about-journal__caption">{{ block.settings.caption | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.note != blank -%}
                    <p class="about-journal__note">{{ block.settings.note | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if navigation_count > 1 -%}
        <div class="about-journal__controls" role="group" aria-label="{{ section.settings.heading | default: 'Photo album' | escape }} navigation">
          <span class="about-journal__control-label">Browse the lookbook</span>
          <span class="about-journal__position" data-journal-position-for="AboutJournalPhotos-{{ section.id }}" aria-live="polite">01 / {{ navigation_count_label }}</span>
          <button type="button" class="about-journal__control" data-journal-direction="previous" aria-controls="AboutJournalPhotos-{{ section.id }}" aria-label="Previous {{ navigation_item }}">
            <span aria-hidden="true">←</span>
          </button>
          <button type="button" class="about-journal__control" data-journal-direction="next" aria-controls="AboutJournalPhotos-{{ section.id }}" aria-label="Next {{ navigation_item }}">
            <span aria-hidden="true">→</span>
          </button>
        </div>
      {%- endif -%}

      {%- if journal_mode == 'tour' -%}
        <ol id="AboutJournalPhotos-{{ section.id }}" class="about-journal__photos about-journal__photos--tour" tabindex="0" aria-label="{{ section.settings.heading | default: 'A tour of the boutique' | escape }}">
          {{ photo_items }}
        </ol>
      {%- else -%}
        <ul id="AboutJournalPhotos-{{ section.id }}" class="about-journal__photos about-journal__photos--album" tabindex="0" aria-label="{{ section.settings.heading | default: 'Boutique photo album' | escape }}">
          {{ photo_items }}
        </ul>
      {%- endif -%}

      {%- if section.settings.closing_note != blank -%}
        <p class="about-journal__closing">{{ section.settings.closing_note | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    if (window.beauBouAboutJournalControls) return;
    window.beauBouAboutJournalControls = true;

    function updatePosition(rail) {
      var items = rail.querySelectorAll('.about-journal__item');
      if (!items.length) return;
      var gap = parseFloat(window.getComputedStyle(rail).gap) || 0;
      var distance = items[0].getBoundingClientRect().width + gap;
      var index = Math.round(rail.scrollLeft / distance);
      index = Math.max(0, Math.min(items.length - 1, index));
      var visibleCount = Math.max(1, Math.floor((rail.clientWidth + gap) / distance));
      var position = document.querySelector('[data-journal-position-for="' + rail.id + '"]');
      if (position) {
        var first = String(index + 1).padStart(2, '0');
        var last = String(Math.min(items.length, index + visibleCount)).padStart(2, '0');
        var label = first + (visibleCount > 1 ? '–' + last : '') + ' / ' + String(items.length).padStart(2, '0');
        if (position.textContent !== label) position.textContent = label;
      }
    }

    function move(rail, direction) {
      var item = rail.querySelector('.about-journal__item');
      if (!item) return;
      var gap = parseFloat(window.getComputedStyle(rail).gap) || 0;
      var distance = item.getBoundingClientRect().width + gap;
      rail.scrollBy({
        left: distance * direction,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    }

    document.addEventListener('click', function (event) {
      if (!(event.target instanceof Element)) return;
      var button = event.target.closest('[data-journal-direction]');
      if (!button) return;
      var rail = document.getElementById(button.getAttribute('aria-controls'));
      if (rail) move(rail, button.dataset.journalDirection === 'next' ? 1 : -1);
    });

    document.addEventListener('scroll', function (event) {
      if (event.target instanceof Element && event.target.matches('.about-journal__photos')) {
        updatePosition(event.target);
      }
    }, true);

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      if (!(event.target instanceof Element)) return;
      var rail = event.target.closest('.about-journal__photos');
      if (!rail) return;
      event.preventDefault();
      move(rail, event.key === 'ArrowRight' ? 1 : -1);
    });

    function initializePositions() {
      document.querySelectorAll('.about-journal__photos').forEach(updatePosition);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializePositions, { once: true });
    } else {
      initializePositions();
    }
    document.addEventListener('shopify:section:load', initializePositions);
    window.addEventListener('resize', initializePositions);
  })();
</script>

{% schema %}
{
  "name": "About photo journal",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Presentation",
      "options": [
        { "value": "album", "label": "Family and lifestyle album" },
        { "value": "tour", "label": "Store tour" }
      ],
      "default": "album"
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "textarea", "id": "closing_note", "label": "Closing note" },
    { "type": "range", "id": "step_start", "label": "First tour stop number", "min": 1, "max": 20, "step": 1, "default": 1 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption or tour stop" },
        { "type": "text", "id": "alt", "label": "Image description for accessibility" },
        { "type": "textarea", "id": "note", "label": "Short note" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "About photo album", "settings": { "mode": "album" } },
    { "name": "About store tour", "settings": { "mode": "tour" } }
  ]
}
{% endschema %}
