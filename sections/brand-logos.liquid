{%- comment -%}
  Brand logos — Amber's reference (2026-10-18): a big serif heading over a clean grid of black brand
  logos, 6 across on desktop. One block per brand: upload its logo, or leave it blank to show the brand
  name as a wordmark. Each tile links to the brand's collection (or Shopify's vendor page).
  Docs: docs/landing-sections.md
{%- endcomment -%}
{{ 'section-brand-logos.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #BrandLogos-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #BrandLogos-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="BrandLogos-{{ section.id }}" class="brand-logos color-{{ section.settings.color_scheme }} gradient{% if section.settings.black_logos %} brand-logos--mono{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="brand-logos__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="brand-logos__grid list-unstyled" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign logo = block.settings.logo
            if logo != blank and logo.src == blank
              assign fname = logo | remove: 'shopify://shop_images/'
              assign logo = images[fname]
            endif
            assign link = block.settings.link
            if link == blank and block.settings.collection != blank
              assign link = block.settings.collection.url
            endif
            assign name = block.settings.name | default: block.settings.collection.title
          -%}
          <li class="brand-logos__item" {{ block.shopify_attributes }}>
            {%- if link != blank -%}<a class="brand-logos__link" href="{{ link }}">{%- else -%}<span class="brand-logos__link">{%- endif -%}
              {%- if logo != blank -%}
                {{
                  logo
                  | image_url: width: 480
                  | image_tag: loading: 'lazy', widths: '160, 240, 320, 480', sizes: '(min-width: 990px) 180px, 40vw', class: 'brand-logos__logo', alt: name
                }}
              {%- else -%}
                <span class="brand-logos__wordmark">{{ name | escape }}</span>
              {%- endif -%}
            {%- if link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="brand-logos__hint">Add a <b>Brand</b> block for each brand Michele carries.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Brand logos",
  "tag": "section",
  "class": "section section--brand-logos",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the brands we carry" },
    { "type": "checkbox", "id": "black_logos", "label": "Show logos in black", "default": true, "info": "Turns colored logos solid black so the row looks like one set." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "info": "Shown as text until a logo is added; also the logo's alt text." },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Transparent PNG or SVG works best." },
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Overrides the collection, e.g. /collections/vendors?q=Brand" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [ { "name": "Brand logos", "blocks": [ { "type": "brand" }, { "type": "brand" }, { "type": "brand" } ] } ]
}
{% endschema %}
