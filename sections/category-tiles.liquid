{{ 'section-category-tiles.css' | asset_url | stylesheet_tag }}
{%- assign card_style = section.settings.tile_style | default: 'classic' -%}
{%- if card_style == 'card' -%}
  {{ 'component-bb-cards.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Tiles-{{ section.id }} {
    --tiles-columns: {{ section.settings.columns_desktop }};
    --bb-card-columns: {{ section.settings.columns_desktop }};
    --tile-ratio: {{ section.settings.image_ratio }};
  }
{%- endstyle -%}

<div class="category-tiles color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding page-width" id="Tiles-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="category-tiles__header">
      <h2 class="category-tiles__title bb-display">{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <ul class="{% if card_style == 'card' %}bb-card-grid bb-card-grid--mobile-{{ section.settings.columns_mobile }}{% else %}category-tiles__grid category-tiles__grid--mobile-{{ section.settings.columns_mobile }}{% endif %}" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign bb_tile_image = block.settings.image
        if bb_tile_image != blank and bb_tile_image.src == blank
          assign bb_fname = bb_tile_image | remove: 'shopify://shop_images/'
          assign bb_tile_image = images[bb_fname]
        endif
        assign image = bb_tile_image | default: collection.featured_image
        assign caption = block.settings.caption | default: collection.title
        assign link = block.settings.link | default: collection.url
      -%}
      {%- if card_style == 'card' -%}
        <li {{ block.shopify_attributes }}>
          {%- render 'card-category',
            image: image,
            title: caption,
            link: link,
            tag: block.settings.tag,
            subtitle: block.settings.subtitle,
            button_label: block.settings.button_label,
            index: forloop.index
          -%}
        </li>
        {%- continue -%}
      {%- endif -%}
      <li class="category-tiles__item" {{ block.shopify_attributes }}>
        <a href="{{ link | default: '#' }}" class="category-tiles__link">
          <div class="category-tiles__frame bb-frame">
            <div class="category-tiles__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 8rem) / 2), 100vw',
                    class: 'category-tiles__image',
                    alt: caption
                }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if caption != blank -%}
              <span class="category-tiles__caption bb-display">{{ caption | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "select", "id": "tile_style", "default": "classic", "label": "Tile style",
      "options": [
        { "value": "classic", "label": "Classic: photo with caption" },
        { "value": "card", "label": "Card: rounded photo with frosted label and button" }
      ] },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "default": 3, "label": "Columns on desktop" },
    { "type": "select", "id": "columns_mobile", "default": "1", "label": "Columns on mobile",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
    { "type": "select", "id": "image_ratio", "default": "1 / 1.15", "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "1 / 1.15", "label": "Tall (reference)" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "4 / 3", "label": "Landscape" }
      ] },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36, "label": "Bottom" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Image, caption and link fall back to this collection." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "caption", "label": "Caption override" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "header", "content": "Card style only" },
        { "type": "text", "id": "tag", "label": "Tag", "info": "Small gold pill, e.g. Clearance. Leave blank to hide." },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Small line under the name. Leave blank to hide." },
        { "type": "text", "id": "button_label", "label": "Button label", "placeholder": "Shop now" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "caption": "Swimsuits" } },
        { "type": "tile", "settings": { "caption": "Dresses + Formal Wear" } },
        { "type": "tile", "settings": { "caption": "Everyday Wear" } }
      ]
    }
  ]
}
{% endschema %}
