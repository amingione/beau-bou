{%- comment -%}
  Collections carousel — Figma "Fashion Website Landing Page", node 1:135.
  Gray band, centered heading, a swipeable row of rounded square collection tiles with the
  name over the picture, and one outlined button under the row.
  Tile style "Category card" swaps the squares for the category card (snippets/card-category).
  Docs: docs/landing-sections.md
{%- endcomment -%}
{{ 'component-bb-scroller.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-carousel.css' | asset_url | stylesheet_tag }}
{%- if section.settings.tile_style == 'card' -%}
  {{ 'component-bb-cards.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<script src="{{ 'bb-scroller.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #CollectionCarousel-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #CollectionCarousel-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="CollectionCarousel-{{ section.id }}"
  class="cc color-{{ section.settings.color_scheme }} gradient cc--{{ section.settings.tile_style }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="cc__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <bb-scroller class="cc__rail">
      <ul
        class="bb-scroller__track cc__track"
        role="list"
        tabindex="0"
        aria-label="{{ section.settings.heading | default: 'Collections' | escape }}"
        data-scroller-track
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign label = block.settings.label | default: col.title
            assign link = block.settings.link | default: col.url
            assign img = block.settings.image
            if img != blank and img.src == blank
              assign fname = img | remove: 'shopify://shop_images/'
              assign img = images[fname]
            endif
            if img == blank and col != blank
              assign img = col.image | default: col.featured_image
            endif
          -%}
          <li class="cc__item" {{ block.shopify_attributes }}>
            {%- if section.settings.tile_style == 'card' -%}
              {%- render 'card-category',
                image: img,
                title: label,
                link: link,
                button_label: section.settings.card_button_label,
                sizes: '(min-width: 990px) 280px, 64vw',
                index: forloop.index
              -%}
            {%- else -%}
              <a class="cc-tile{% if img == blank %} cc-tile--text{% endif %}" href="{{ link | default: '#' }}">
                {%- if img != blank -%}
                  {{
                    img
                    | image_url: width: 660
                    | image_tag:
                      loading: 'lazy',
                      widths: '220, 330, 440, 660',
                      sizes: '(min-width: 750px) 220px, 160px',
                      class: 'cc-tile__img',
                      alt: ''
                  }}
                {%- endif -%}
                <span class="cc-tile__label">{{ label | escape }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'bb-scroller-buttons', label: 'collections' %}
    </bb-scroller>
  {%- elsif request.design_mode -%}
    <p class="cc__hint page-width">Add a <b>Collection</b> block for each one to show: Dresses, Tops, Bottoms, Handbags…</p>
  {%- endif -%}

  {%- if section.settings.button_label != blank -%}
    <div class="cc__more">
      <a class="cc__button" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label | escape }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collections carousel",
  "tag": "section",
  "class": "section section--collection-carousel",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "select", "id": "tile_style", "label": "Tile style", "default": "square", "options": [
      { "value": "square", "label": "Square tiles with the name on the picture" },
      { "value": "card", "label": "Category card (photo, frosted panel, Shop now)" } ] },
    { "type": "text", "id": "card_button_label", "label": "Category card button", "default": "Shop now" },
    { "type": "text", "id": "button_label", "label": "Button under the row", "default": "Shop all", "info": "Leave blank for no button." },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the page listing every collection." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60, "label": "Bottom padding" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Picture", "info": "Optional. Uses the collection's own picture if blank; with neither, the tile shows just the name." },
        { "type": "text", "id": "label", "label": "Name on the tile", "info": "Optional. Defaults to the collection's name." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Defaults to the collection." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Collections carousel", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }
  ]
}
{% endschema %}
