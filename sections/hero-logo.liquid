{%- liquid
  assign bb_logo = section.settings.logo
  if bb_logo != blank and bb_logo.src == blank
    assign bb_fname = bb_logo | remove: 'shopify://shop_images/'
    assign bb_logo = images[bb_fname]
  endif
-%}
{%- liquid
  assign bb_image = section.settings.image
  if bb_image != blank and bb_image.src == blank
    assign bb_fname = bb_image | remove: 'shopify://shop_images/'
    assign bb_image = images[bb_fname]
  endif

  assign bb_image_mobile = section.settings.image_mobile
  if bb_image_mobile != blank and bb_image_mobile.src == blank
    assign bb_fname = bb_image_mobile | remove: 'shopify://shop_images/'
    assign bb_image_mobile = images[bb_fname]
  endif
-%}
{{ 'section-hero-logo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #Hero-{{ section.id }} .hero-logo__media {
    --hero-min-height: {{ section.settings.min_height }}vh;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  assign frame_class = ''
  if section.settings.show_frame
    assign frame_class = ' bb-frame'
  endif
-%}

<div class="hero-logo{% if section.settings.content_below_image %} hero-logo--content-below{% endif %} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if section.settings.full_width %} hero-logo--full{% else %} page-width{% endif %}" id="Hero-{{ section.id }}">
  {%- liquid
  assign hero_alt = bb_image.alt
  if hero_alt == blank
    assign hero_alt = shop.name | append: ', downtown Punta Gorda, Florida'
  endif
-%}
<div class="hero-logo__media{{ frame_class }}">
    {%- if bb_image != blank -%}
      <picture>
        {%- if bb_image_mobile != blank -%}
          {%- comment -%} Art direction: phones get their own (square) cover instead of a crop of the wide one. {%- endcomment -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ bb_image_mobile | image_url: width: 540 }} 540w, {{ bb_image_mobile | image_url: width: 750 }} 750w, {{ bb_image_mobile | image_url: width: 1080 }} 1080w"
            sizes="100vw"
            width="{{ bb_image_mobile.width }}"
            height="{{ bb_image_mobile.height }}"
          >
        {%- endif -%}
        {{
          bb_image
          | image_url: width: 3200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1920, 2400, 3200',
            sizes: '100vw',
            class: 'hero-logo__image',
            alt: hero_alt
        }}
      </picture>
    {%- else -%}
      <div class="hero-logo__placeholder">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    {%- endif -%}

    <div class="hero-logo__overlay" aria-hidden="true"></div>

    <div class="hero-logo__content hero-logo__content--{{ section.settings.content_position }}">
      {%- if bb_logo != blank -%}
        <div class="hero-logo__logo" style="--logo-width: {{ section.settings.logo_width }}px;">
          {{
            bb_logo
            | image_url: width: 1200
            | image_tag: loading: 'eager', widths: '300, 600, 900, 1200', sizes: '(min-width: 750px) 600px, 70vw', alt: shop.name
          }}
        </div>
      {%- elsif section.settings.heading != blank -%}
        <h2 class="hero-logo__heading bb-display">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="hero-logo__tagline bb-display">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.accent != blank -%}
        <p class="hero-logo__accent bb-accent">{{ section.settings.accent | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button hero-logo__button">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero with logo",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "content_below_image", "label": "Show content below the cover image", "default": false },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Wide storefront or rack shot. 2400×1000 or larger." },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image (optional)", "info": "Square cover for phones, 1080×1080. Leave blank to use the background image." },
    { "type": "image_picker", "id": "logo", "label": "Logo overlay", "info": "Transparent PNG/SVG. Leave blank to show the heading instead." },
    { "type": "range", "id": "logo_width", "min": 160, "max": 800, "step": 20, "unit": "px", "default": 480, "label": "Logo width (desktop)" },
    { "type": "text", "id": "heading", "default": "Be-YOU-tiful Boutique", "label": "Heading (fallback when no logo)" },
    { "type": "text", "id": "tagline", "default": "Swimwear to formal wear · XXS to 2X", "label": "Tagline" },
    { "type": "text", "id": "accent", "default": "Accept yourself as you were designed by God", "label": "Accent line (script/italic)" },
    { "type": "text", "id": "button_label", "default": "Shop What's New", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "content_position", "default": "center", "label": "Content position",
      "options": [ { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" } ] },
    { "type": "range", "id": "min_height", "min": 30, "max": 90, "step": 5, "unit": "vh", "default": 60, "label": "Minimum height" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25, "label": "Image overlay" },
    { "type": "checkbox", "id": "show_frame", "default": true, "label": "Hairline frame around image" },
    { "type": "checkbox", "id": "full_width", "default": false, "label": "Full width" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24, "label": "Top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24, "label": "Bottom" }
  ],
  "presets": [ { "name": "Hero with logo" } ]
}
{% endschema %}
