{%- liquid
  assign bb_image = section.settings.image
  if bb_image != blank and bb_image.src == blank
    assign bb_fname = bb_image | remove: 'shopify://shop_images/'
    assign bb_image = images[bb_fname]
  endif
-%}
{{ 'section-page-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank and page
    assign heading = page.title
  endif
-%}

<div class="page-hero color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if bb_image != blank %} page-hero--has-image{% endif %}">
  <div class="page-width page-hero__inner{% if bb_image != blank %} page-hero__inner--split{% endif %}">
    <div class="page-hero__text">
      {%- if section.settings.eyebrow != blank -%}<span class="bb-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h1 class="page-hero__heading bb-display">{{ heading | escape }}</h1>
      {%- if section.settings.accent != blank -%}<p class="page-hero__accent bb-accent">{{ section.settings.accent | escape }}</p>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="page-hero__body rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--secondary page-hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if bb_image != blank -%}
      <div class="page-hero__media bb-frame">
        {{ bb_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1400', sizes: '(min-width: 990px) 45vw, 100vw', class: 'page-hero__image' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "text", "id": "accent", "label": "Accent line (italic serif)" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Adds a framed image beside the text." },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24, "label": "Bottom padding" }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
