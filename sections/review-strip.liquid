{{ 'section-review-strip.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="review-strip color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.rating_line != blank -%}
      <header class="review-strip__header">
        {%- if section.settings.heading != blank -%}<h2 class="review-strip__heading bb-display">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.rating_line != blank -%}
          <p class="review-strip__rating">
            <span class="review-strip__stars" aria-hidden="true">★★★★★</span>
            {%- if section.settings.rating_link != blank -%}
              <a href="{{ section.settings.rating_link }}" target="_blank" rel="noopener">{{ section.settings.rating_line | escape }}</a>
            {%- else -%}
              {{ section.settings.rating_line | escape }}
            {%- endif -%}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <ul class="review-strip__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="review-strip__item bb-frame" {{ block.shopify_attributes }}>
          <span class="review-strip__stars" aria-label="5 out of 5 stars">★★★★★</span>
          <blockquote class="review-strip__quote">{{ block.settings.quote }}</blockquote>
          <cite class="review-strip__cite bb-display">{{ block.settings.name | escape }}{% if block.settings.source != blank %} · <span>{{ block.settings.source | escape }}</span>{% endif %}</cite>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "default": "What our customers say", "label": "Heading" },
    { "type": "text", "id": "rating_line", "default": "5.0 on Google · 15 reviews", "label": "Rating line" },
    { "type": "url", "id": "rating_link", "label": "Rating link (Google Business Profile)" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Top padding" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48, "label": "Bottom padding" }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Classy and stylish! Michele offers knowledgeable and friendly service from the moment you step in — it's like shopping with a friend!</p>" },
      { "type": "text", "id": "name", "label": "Name", "default": "Amity" },
      { "type": "text", "id": "source", "label": "Source", "default": "Google review" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] } ]
}
{% endschema %}
