{{ 'section-size-guide.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="size-guide color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width size-guide__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="size-guide__heading bb-display">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <div class="size-guide__intro rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- assign size_rows = section.blocks | where: 'type', 'row' -%}
    {%- if size_rows.size > 0 -%}
    <div class="size-guide__table-wrap">
      <table class="size-guide__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_size | default: 'Size' | escape }}</th>
            <th scope="col">{{ section.settings.col_us | default: 'US' | escape }}</th>
            <th scope="col">{{ section.settings.col_bust | default: 'Bust' | escape }}</th>
            <th scope="col">{{ section.settings.col_waist | default: 'Waist' | escape }}</th>
            <th scope="col">{{ section.settings.col_hips | default: 'Hips' | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row" class="bb-display">{{ block.settings.size | escape }}</th>
                <td>{{ block.settings.us | escape }}</td>
                <td>{{ block.settings.bust | escape }}</td>
                <td>{{ block.settings.waist | escape }}</td>
                <td>{{ block.settings.hips | escape }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- endif -%}

    {%- assign tips = section.blocks | where: 'type', 'tip' -%}
    {%- if tips.size > 0 -%}
      <div class="size-guide__tips">
        {%- for block in tips -%}
          <div class="size-guide__tip bb-frame" {{ block.shopify_attributes }}>
            <h3 class="size-guide__tip-title bb-display">{{ block.settings.title | escape }}</h3>
            <div class="rte">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="size-guide__footnote bb-accent">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Size guide",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Find your fit",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Sizes vary by brand, style and fabric. Check the product’s fit notes or contact us for its size chart and garment measurements.</p>"
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "text",
      "id": "col_size",
      "default": "Size",
      "label": "Size"
    },
    {
      "type": "text",
      "id": "col_us",
      "default": "US",
      "label": "US size"
    },
    {
      "type": "text",
      "id": "col_bust",
      "default": "Bust",
      "label": "Bust"
    },
    {
      "type": "text",
      "id": "col_waist",
      "default": "Waist",
      "label": "Waist"
    },
    {
      "type": "text",
      "id": "col_hips",
      "default": "Hips",
      "label": "Hips"
    },
    {
      "type": "text",
      "id": "footnote",
      "default": "Not sure? Message us a photo of the tag and your usual size — we'll tell you straight.",
      "label": "Footnote (accent font)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Size row",
      "settings": [
        {
          "type": "text",
          "id": "size",
          "label": "Size"
        },
        {
          "type": "text",
          "id": "us",
          "label": "US"
        },
        {
          "type": "text",
          "id": "bust",
          "label": "Bust"
        },
        {
          "type": "text",
          "id": "waist",
          "label": "Waist"
        },
        {
          "type": "text",
          "id": "hips",
          "label": "Hips"
        }
      ]
    },
    {
      "type": "tip",
      "name": "How-to-measure tip",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bust"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Around the fullest part, tape level and snug but not tight.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [
        {
          "type": "tip",
          "settings": {
            "title": "Bust",
            "text": "<p>Around the fullest part, tape level and snug but not tight.</p>"
          }
        },
        {
          "type": "tip",
          "settings": {
            "title": "Waist",
            "text": "<p>Around your natural waist — the narrowest point, usually just above the belly button.</p>"
          }
        },
        {
          "type": "tip",
          "settings": {
            "title": "Hips",
            "text": "<p>Around the fullest part of your hips and seat, feet together.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
