{% comment %}
  Renders an always-visible search field in the header (desktop only).
  Pairs with header-search.liquid, which remains the mobile/modal fallback.

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-inline-search', input_id: 'Search-Inline' %}
{% endcomment %}

<div class="header__inline-search small-hide medium-hide">
  <form action="{{ routes.search_url }}" method="get" role="search" class="inline-search">
    <label class="visually-hidden" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
    <input
      class="inline-search__input"
      id="{{ input_id }}"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.search' | t }}..."
      autocomplete="off"
    >
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="inline-search__button" aria-label="{{ 'general.search.search' | t }}">
      <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
    </button>
  </form>
</div>
