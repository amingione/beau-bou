{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: settings.bb_meta_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- liquid
  # fall back to Theme settings → Search & social listing → Default share image (docs/seo.md)
  assign bb_og_image = page_image
  if bb_og_image == blank and settings.bb_share_image != blank
    assign bb_og_image = settings.bb_share_image
    if bb_og_image.src == blank
      assign bb_fname = bb_og_image | remove: 'shopify://shop_images/'
      assign bb_og_image = images[bb_fname]
    endif
  endif
-%}
{%- if bb_og_image != blank -%}
  {%- comment -%} Shopify never upscales, so cap at the source width and size the height from it {%- endcomment -%}
  {%- assign bb_og_w = bb_og_image.width | at_most: 1200 -%}
  <meta property="og:image" content="https:{{ bb_og_image | image_url: width: bb_og_w }}">
  <meta property="og:image:secure_url" content="https:{{ bb_og_image | image_url: width: bb_og_w }}">
  <meta property="og:image:width" content="{{ bb_og_w }}">
  <meta property="og:image:height" content="{{ bb_og_w | divided_by: bb_og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ bb_og_image.alt | default: shop.name | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
