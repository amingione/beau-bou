      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "quote": "<p>This boutique has the most adorable selections in Punta Gorda! Classy and stylish! Michele offers knowledgeable and friendly service from the moment you step in — it's like shopping with a friend!</p>",
            "name": "Amity",
            "source": "Google review"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "quote": "<p>The clothing is very unique, reasonably priced and the owner Michele and her staff are so friendly. This is definitely a judgment free zone! Michele encourages us to love ourselves for who we are!</p>",
            "name": "Lori",
            "source": "Google review"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "<p>The space in Michele's store is absolutely gorgeous. If you're looking for something for a fun night out you must check this store. Unique & different plus cute fun hats & totes. A little of everything.</p>",
            "name": "AnnaMarie",
            "source": "Google review"
          }
        }
