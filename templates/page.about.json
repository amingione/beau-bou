        "r1": {
          "type": "review",
          "settings": {
            "quote": "<p>Highly recommend stopping by. We were going to go to the mall for dress shopping for a wedding but found everything that we needed local. They even have kids apparel. … 10/10 recommend</p>",
            "name": "Tonya",
            "source": "Facebook review"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "quote": "<p>Beautiful and sparkly display of womenswear, accessories, ornaments and jewelry. Michele does a great job buying for the shop. I always find multiple things that I love when I visit. Love!!!</p>",
            "name": "Judith",
            "source": "Facebook review"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "<p>First time visiting and I love this boutique, nice clothes, lots of sizes and prices are not bad at all. Michele was so helpful, I plan on returning soon. Got two new dresses for my cruise!!</p>",
            "name": "Annette",
            "source": "Facebook review"
          }
        }
