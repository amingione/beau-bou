    "hero": {
      "type": "page-hero",
      "settings": {
        "eyebrow": "Downtown Punta Gorda since day one",
        "heading": "Meet Michele",
        "accent": "Accept yourself as you were designed by God",
        "text": "<p>Be-YOU-tiful Boutique started with one idea: every woman who walks in should find something that makes her stand a little taller — whatever her size, her budget, or the occasion. Swimsuits to gowns, XS to 3X, priced so you can say yes.</p>",
        "button_label": "Shop What's New",
        "button_link": "shopify://collections/new-arrivals",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 36,
        "image": "shopify://shop_images/beyoutiful-michele-portrait.jpg"
      }
    },
    "story": {
      "type": "image-with-text",
